{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "whoami",
  "compatibility_date": "2026-11-06",
  // Build the static site before every `wrangler deploy` / `wrangler dev`,
  // so Workers Builds works even without a build command configured.
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
