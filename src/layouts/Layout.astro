---
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Òscar Pérez" } = Astro.props;

const nav = [
  { label: "photos", href: "/photos" },
  { label: "music", href: "/music" },
  { label: "activities", href: "/activities" },
];

const current = Astro.url.pathname.replace(/(\.html|\/)$/, "").replace(/\/index$/, "") || "/";

// Like deadsimplesites.com's "Last updated" line — stamped at build time, ISO 8601 (no ms).
const updated = new Date().toISOString().replace(/\.\d+Z$/, "Z");
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <Font cssVariable="--font-geist-mono" preload />
    <!-- Client-side navigation: pages swap in place instead of a full reload. -->
    <ClientRouter />
  </head>
  <body>
    <div class="page">
      <nav aria-label="Main" transition:name="nav" transition:animate="none">
        <a href="/" class="name" aria-current={current === "/" ? "page" : undefined}>Òscar Pérez</a>
        <div class="links">
          {
            nav.map((item) => (
              <a href={item.href} aria-current={current === item.href ? "page" : undefined}>
                {item.label}
              </a>
            ))
          }
        </div>
      </nav>
      <main transition:animate="fade">
        <slot />
      </main>
      <footer class="muted" transition:name="footer" transition:animate="none">
        <span>© {new Date().getFullYear()} Òscar Pérez</span>
        <span class="nowrap">last updated <time datetime={updated}>{updated}</time></span>
      </footer>
    </div>
  </body>
</html>

<style is:global>
  :root {
    /* Warm off-white, not pure white. */
    --background-color: #f5f4f1;
    --foreground-color: #262523;
    --muted: color-mix(in srgb, var(--foreground-color) 50%, transparent);
    --hairline: 1px solid color-mix(in srgb, var(--foreground-color) 10%, transparent);
    /* One spacing scale for every page: a label and what it labels (1), rows and inline
       icons (2), paragraphs and side-by-side items (3), groups inside a block (4), blocks (5). */
    --space-1: 0.25rem;
    --space-2: 0.5rem;
    --space-3: 1rem;
    --space-4: 1.5rem;
    --space-5: 4rem;
    /* Secondary text (captions, labels, credits): one size everywhere. */
    --small: 12px;
    color-scheme: light;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    background: var(--background-color);
    color: var(--foreground-color);
    font-family: var(--font-geist-mono);
    -webkit-font-smoothing: antialiased;
    /* Keep the scrollbar's space, so locking scroll (photo viewer) doesn't shift the page. */
    scrollbar-gutter: stable;
    /* No grey/blue flash when tapping links and buttons (inherited by everything). */
    -webkit-tap-highlight-color: transparent;
  }

  button {
    -webkit-user-select: none;
    user-select: none;
  }

  button:focus:not(:focus-visible) {
    outline: none;
  }

  body {
    margin: 0;
    font-size: 15px;
    line-height: max(22px, 3vh);
  }

  h1,
  h2,
  p,
  figure {
    margin: 0;
    font-size: inherit;
    font-weight: inherit;
  }

  img {
    display: block;
    max-width: 100%;
    height: auto;
  }

  /* The thin, faded underline. */
  a {
    color: inherit;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 5px;
    text-decoration-color: color-mix(in srgb, var(--foreground-color) 35%, transparent);
    transition: text-decoration-color 150ms;
    outline: none;
  }

  a:hover,
  a:focus-visible {
    text-decoration-color: var(--foreground-color);
  }

  /* One narrow, left-aligned column — the dead simple layout.
     Full-height flex column so the footer always sits at the bottom. */
  .page {
    max-width: 40rem;
    min-height: 100dvh;
    margin: 0 auto;
    padding: 2rem 1.5rem;
    display: flex;
    flex-direction: column;
  }

  main {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    padding: 10vh 0 6rem;
  }

  /* Page title with its one-line intro underneath. */
  main > header {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .muted {
    color: var(--muted);
  }
</style>

<style>
  nav {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 2rem;
    font-size: 13px;
  }

  footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.25rem 1rem;
    font-size: var(--small);
    line-height: 1.5;
  }

  .nowrap {
    white-space: nowrap;
  }

  .links {
    display: flex;
    gap: 1.5rem;
  }

  nav .name {
    white-space: nowrap;
  }

  @media (max-width: 480px) {
    .links {
      gap: 1rem;
    }
  }

  nav a {
    text-decoration: none;
    opacity: 0.5;
    transition: opacity 150ms;
  }

  nav a:hover,
  nav a:focus-visible,
  nav a[aria-current="page"],
  nav .name {
    opacity: 1;
  }
</style>
