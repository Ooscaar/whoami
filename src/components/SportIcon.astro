---
// Small line icons per sport, drawn for this site (16×16, stroked with currentColor).
interface Props {
  sport: string;
  color?: string;
}

const { sport, color } = Astro.props;

const kind = /ride/i.test(sport)
  ? "ride"
  : /run/i.test(sport)
    ? "run"
    : /swim/i.test(sport)
      ? "swim"
      : /ski|snowboard/i.test(sport)
        ? "ski"
        : /hike|walk/i.test(sport)
          ? "hike"
          : /tennis|padel|squash|badminton|pickleball/i.test(sport)
            ? "tennis"
            : "other";
---

<svg class="sport-icon" viewBox="0 0 16 16" aria-hidden="true" style={color ? `color: ${color}` : undefined}>
  {
    // Mountain bike: chunky tyres, sloped top tube, suspension fork, riser bar.
    kind === "ride" && (
      <>
        <circle cx="3.6" cy="11.4" r="2.9" class="tyre" />
        <circle cx="12.4" cy="11.4" r="2.9" class="tyre" />
        <path d="M3.6 11.4 7.3 11.2 6.2 6.3M3.6 11.4 6.6 7.6 10.6 6.4M7.3 11.2 10.6 6.4M10.6 6.4 11.3 8.6M11.3 8.6 12.4 11.4M5.1 6.1h2.3M10.6 6.4 10.2 4.4M9.2 4.4h2.4" />
        <path d="M10.75 7.3 11.85 8.1" class="shock" />
      </>
    )
  }
  {
    kind === "run" && (
      <>
        <circle cx="10" cy="2.75" r="1.25" />
        <path d="M5 6.5 8 5l2.5 2 2.5.5M8 5 6.5 9.5l3 1.5-1 4M6.5 9.5 5 12.5l-3 .5" />
      </>
    )
  }
  {
    kind === "swim" && (
      <>
        <circle cx="11.5" cy="5" r="1.25" />
        <path d="M3 8.5 7.5 6l2 2.5M1 12c1.2-1 2.3-1 3.5 0s2.3 1 3.5 0 2.3-1 3.5 0 2.3 1 3.5 0" />
      </>
    )
  }
  {
    // Alpine skier heading downhill: tucked body, poles, skis on the slope.
    kind === "ski" && (
      <>
        <circle cx="10.5" cy="2.6" r="1.3" />
        <path d="M9.8 4.4 7.6 8.6M7.6 8.6l2.4 2.2-1.4 2.6M7.6 8.6l-.7 2.8-1.6 1.5M9.4 5.2l2.8 2 1.4 4.8M9 5.6 6.4 7.4l-2 4M1.5 11.7l13 3.5" />
      </>
    )
  }
  {kind === "hike" && <path d="M1 13.5 6 5l3 4.5 2-2.5 4 6.5zM4.75 7.1 6 8.2l1.2-1.1" />}
  {
    kind === "tennis" && (
      <>
        <circle cx="8" cy="8" r="6" />
        <path d="M3.3 4.3c2.3 2 2.3 5.4 0 7.4M12.7 4.3c-2.3 2-2.3 5.4 0 7.4" />
      </>
    )
  }
  {kind === "other" && <path d="M1 8.5h3.5L6.5 4l3 8.5 2-4H15" />}
</svg>

<style>
  .tyre {
    stroke-width: 1.6;
  }

  .shock {
    stroke-width: 2;
  }

  .sport-icon {
    flex: none;
    display: inline-block;
    width: 14px;
    height: 14px;
    vertical-align: -2px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.25;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
