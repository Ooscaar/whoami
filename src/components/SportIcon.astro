---
// Small icons per sport. Most are line icons drawn for this site (16×16, stroked with
// currentColor); the mountain bike and the skier are filled glyphs from Google's Material
// Symbols (https://fonts.google.com/icons, Apache License 2.0).
interface Props {
  sport: string;
}

const { sport } = Astro.props;

const kind = /ride/i.test(sport)
  ? "ride"
  : /run/i.test(sport)
    ? "run"
    : /swim/i.test(sport)
      ? "swim"
      : /ski|snowboard/i.test(sport)
        ? "ski"
        : /hike|walk/i.test(sport)
          ? "hike"
          : /tennis|padel|squash|badminton|pickleball/i.test(sport)
            ? "tennis"
            : "other";
---

<svg
  class="sport-icon"
  viewBox={kind === "ride" || kind === "ski" ? "0 -960 960 960" : "0 0 16 16"}
  aria-hidden="true"
>
  {
    // Mountain bike: Material Symbols "pedal_bike" (Apache 2.0, see the note above).
    kind === "ride" && <path class="glyph" d="M194-160q-81 0-137.5-57T0-355q0-81 57.04-137.5T195-549q71 0 124.5 45.5T384-388h51l-82-232h-43q-12.75 0-21.37-8.68-8.63-8.67-8.63-21.5 0-12.82 8.63-21.32 8.62-8.5 21.37-8.5h128q12.75 0 21.38 8.68 8.62 8.67 8.62 21.5 0 12.82-8.62 21.32-8.63 8.5-21.38 8.5h-22l26 71h222l-71-191h-75q-12.75 0-21.37-8.68-8.63-8.67-8.63-21.5 0-12.82 8.63-21.32 8.62-8.5 21.37-8.5h69q24 0 40.5 11t24.5 33l76 207h38q80.51 0 137.26 56.23Q960-436.53 960-356.75 960-276 903.74-218T766-160q-71.6 0-125.8-48T574-328H384q-11 72-64.5 120T194-160Zm0-60q48 0 83.5-31t47.5-77h-89q-12.75 0-21.37-8.68-8.63-8.67-8.63-21.5 0-12.82 8.63-21.32 8.62-8.5 21.37-8.5h89q-12-45-48-73t-82-28q-56 0-95.5 39T60-355q0 56.25 39 95.62Q138-220 194-220Zm305-168h76q4-23 15.5-51t31.5-50H463l36 101Zm267 168q56 0 95-39.38 39-39.37 39-95.62 0-56-39-95t-95-39h-16l29 85q4 11-1 22t-18 16q-11 4-21.5-1.5T723-384l-33-85q-29 17-43.5 48T632-355q0 56.25 39 95.62Q710-220 766-220ZM193-355Zm573 0Z" />
  }
  {
    kind === "run" && (
      <>
        <circle cx="10" cy="2.75" r="1.25" />
        <path d="M5 6.5 8 5l2.5 2 2.5.5M8 5 6.5 9.5l3 1.5-1 4M6.5 9.5 5 12.5l-3 .5" />
      </>
    )
  }
  {
    kind === "swim" && (
      <>
        <circle cx="11.5" cy="5" r="1.25" />
        <path d="M3 8.5 7.5 6l2 2.5M1 12c1.2-1 2.3-1 3.5 0s2.3 1 3.5 0 2.3-1 3.5 0 2.3 1 3.5 0" />
      </>
    )
  }
  {
    // Skier: Material Symbols "downhill_skiing" (Apache 2.0).
    kind === "ski" && <path class="glyph" d="M741-40q-24 0-48-4t-47-11L99-254q-8-3-11.5-10.5T87-280q3-8 10.5-11.5t15.5-.5l270 98 70-181-159-166q-23-26-18-59t34-50l155-90q14-8 30-8.5t30 4.5q14 5 25.5 16t16.5 26l13 43q17 54 49.5 87t79.5 49l15-46q2-8 9-11.5t15-1.5q8 2 12 9.5t2 15.5l-33 102q-68-14-119-54t-78-108l-132 76 112 131q5 6 7 14.5t-1 16.5l-79 205 143 52 94-292q10 3 19 5.5t18 4.5l-94 296 41 14q19 7 39 10.5t42 3.5q24 0 46-3.5T830-95q8-3 16-.5T856-85q3 9-1.5 17T841-57q-24 8-49 12.5T741-40ZM616.5-735.5Q595-757 595-787t21.5-51.5Q638-860 668-860t51.5 21.5Q741-817 741-787t-21.5 51.5Q698-714 668-714t-51.5-21.5Z" />
  }
  {kind === "hike" && <path d="M1 13.5 6 5l3 4.5 2-2.5 4 6.5zM4.75 7.1 6 8.2l1.2-1.1" />}
  {
    kind === "tennis" && (
      <>
        <circle cx="8" cy="8" r="6" />
        <path d="M3.3 4.3c2.3 2 2.3 5.4 0 7.4M12.7 4.3c-2.3 2-2.3 5.4 0 7.4" />
      </>
    )
  }
  {kind === "other" && <path d="M1 8.5h3.5L6.5 4l3 8.5 2-4H15" />}
</svg>

<style>
  .glyph {
    fill: currentColor;
    stroke: none;
  }

  .sport-icon {
    flex: none;
    display: inline-block;
    width: 14px;
    height: 14px;
    vertical-align: -2px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.25;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
