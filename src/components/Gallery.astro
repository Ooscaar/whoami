---
import { Image, getImage } from "astro:assets";
import { photos } from "../data/gallery";

// Optimized large versions for the viewer (instead of the original files).
const large = await Promise.all(
  photos.map((photo) => getImage({ src: photo.src, width: 1600, format: "webp", quality: 75 })),
);
---

<div class="gallery">
  {
    photos.map((photo, i) => (
      <button
        type="button"
        class="thumb"
        data-full={large[i].src}
        data-title={photo.title}
        data-description={photo.description}
        aria-label={`Open ${photo.title}`}
      >
        <Image
          src={photo.src}
          alt={photo.description}
          quality={75}
          widths={[400, 800]}
          sizes="(min-width: 768px) 330px, 50vw"
          loading={i < 4 ? "eager" : "lazy"}
        />
      </button>
    ))
  }
</div>

<dialog class="viewer" aria-label="Photo viewer" tabindex="-1">
  <div class="scrim"></div>

  <div class="top">
    <span class="counter"></span>
    <button type="button" class="close">close</button>
  </div>

  <div class="track">
    <div class="slide"><img alt="" draggable="false" /></div>
    <div class="slide"><img alt="" draggable="false" /></div>
    <div class="slide"><img alt="" draggable="false" /></div>
  </div>

  <div class="caption">
    <p class="title"></p>
    <p class="description"></p>
  </div>
</dialog>

<script>
  const GAP = 20;
  const EASE = "cubic-bezier(0.2, 0.8, 0.2, 1)";

  const reducedMotion = () => window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  const preload = (src: string) => {
    const img = new Image();
    img.src = src;
  };

  // Wait until this exact <img> is decoded, so the viewer never shows a blank or the
  // previous photo for a frame. Never block for long.
  const ready = (img: HTMLImageElement) =>
    Promise.race([
      img.decode().catch(() => {}),
      new Promise((resolve) => setTimeout(resolve, 1500)),
    ]);

  // Runs on every client-side navigation (ClientRouter), not just the first load.
  document.addEventListener("astro:page-load", () => {
    const gallery = document.querySelector<HTMLElement>(".gallery");
    const dialog = document.querySelector<HTMLDialogElement>(".viewer");
    if (!gallery || !dialog) return;

    const items = [...gallery.querySelectorAll<HTMLButtonElement>(".thumb")].map((button) => ({
      button,
      full: button.dataset.full ?? "",
      title: button.dataset.title ?? "",
      description: button.dataset.description ?? "",
    }));
    const n = items.length;

    const track = dialog.querySelector<HTMLElement>(".track")!;
    let slides = [...track.querySelectorAll<HTMLElement>(".slide")]; // [prev, current, next]
    const counter = dialog.querySelector(".counter")!;
    const title = dialog.querySelector(".title")!;
    const description = dialog.querySelector(".description")!;
    let index = 0;
    let width = 0;
    let animating = false;
    let state: "closed" | "opening" | "open" | "closing" = "closed";
    let running: Animation[] = [];
    let opened: Promise<void> = Promise.resolve();
    let flyer: HTMLImageElement | null = null;
    let hidden: HTMLImageElement[] = [];

    const scrim = dialog.querySelector<HTMLElement>(".scrim")!;
    const chrome = [...dialog.querySelectorAll<HTMLElement>(".top, .caption")];

    const at = (i: number) => items[(i + n) % n];
    const imgOf = (slide: HTMLElement) => slide.querySelector("img")!;

    const fill = (slide: HTMLElement, i: number) => {
      const img = imgOf(slide);
      const item = at(i);
      if (img.getAttribute("src") !== item.full) img.src = item.full;
      img.alt = item.description;
    };

    const render = () => {
      slides.forEach((slide, k) => {
        fill(slide, index + k - 1);
        slide.setAttribute("aria-hidden", k === 1 ? "false" : "true");
      });
      const item = at(index);
      counter.textContent = `${index + 1} / ${n}`;
      title.textContent = item.title;
      description.textContent = item.description;
    };

    const measure = () => (width = track.clientWidth + GAP);

    // Position the three slides side by side, shifted by `x` pixels.
    const setOffset = (x: number, ms = 0) => {
      slides.forEach((slide, k) => {
        slide.style.transition = ms ? `transform ${ms}ms ${EASE}` : "none";
        slide.style.transform = `translate3d(${(k - 1) * width + x}px, 0, 0)`;
      });
    };

    const commit = (dir: 1 | -1) => {
      index = (index + dir + n) % n;
      // Rotate the slide elements so nothing visibly jumps, then refill the new edge slide.
      slides = dir === 1 ? [slides[1], slides[2], slides[0]] : [slides[2], slides[0], slides[1]];
      setOffset(0);
      render();
    };

    const go = (dir: 1 | -1, ms = 300) => {
      if (animating || n < 2 || state !== "open") return;
      if (reducedMotion()) return commit(dir);
      animating = true;
      setOffset(-dir * width, ms);
      setTimeout(() => {
        commit(dir);
        animating = false;
      }, ms + 20);
    };

    const thumbOf = (i: number) => at(i).button.querySelector("img")!;

    // The thumbnail's box, if it's on screen (otherwise there's nowhere to fly to).
    const onScreen = (el: HTMLElement) => {
      const r = el.getBoundingClientRect();
      return r.width && r.bottom > 0 && r.top < window.innerHeight ? r : null;
    };

    const fade = (el: HTMLElement, from: number, to: number, ms: number) =>
      el.animate({ opacity: [from, to] }, { duration: ms, easing: EASE, fill: "both" });

    // A copy of the photo that flies between the thumbnail and the viewer, above everything
    // (the real one is clipped by the track). Sized to the viewer's box, so it stays sharp.
    const fly = (src: string, big: DOMRect, small: DOMRect, opening: boolean, ms: number) => {
      flyer = document.createElement("img");
      flyer.src = src;
      flyer.alt = "";
      Object.assign(flyer.style, {
        position: "fixed",
        left: `${big.left}px`,
        top: `${big.top}px`,
        width: `${big.width}px`,
        height: `${big.height}px`,
        maxWidth: "none",
        margin: "0",
        transformOrigin: "0 0",
        pointerEvents: "none",
      });
      dialog.append(flyer);
      const shrunk = `translate(${small.left - big.left}px, ${small.top - big.top}px) scale(${small.width / big.width})`;
      const frames = opening ? [shrunk, "none"] : ["none", shrunk];
      return flyer.animate({ transform: frames }, { duration: ms, easing: EASE, fill: "both" });
    };

    const hide = (...imgs: HTMLImageElement[]) => {
      imgs.forEach((img) => (img.style.visibility = "hidden"));
      hidden.push(...imgs);
    };

    // Put everything back the way it was before the animation, all in one frame.
    const settle = () => {
      running.forEach((a) => a.cancel());
      running = [];
      flyer?.remove();
      flyer = null;
      hidden.forEach((img) => (img.style.visibility = ""));
      hidden = [];
    };

    const open = async (i: number) => {
      if (state !== "closed") return;
      state = "opening";
      index = i;
      render();
      const photo = imgOf(slides[1]);
      await ready(photo);
      dialog.showModal();
      dialog.focus();
      measure();
      setOffset(0);

      const thumb = thumbOf(i);
      const from = onScreen(thumb);
      if (reducedMotion() || !from) {
        state = "open";
        return;
      }
      const ms = 320;
      running = [
        fade(scrim, 0, 1, ms),
        ...chrome.map((el) => fade(el, 0, 1, ms)),
        fly(photo.currentSrc || photo.src, photo.getBoundingClientRect(), from, true, ms),
      ];
      hide(photo, thumb);
      opened = Promise.all(running.map((a) => a.finished)).then(
        () => {
          settle();
          state = "open";
        },
        () => {},
      );
    };

    const close = async () => {
      if (state === "opening") {
        running.forEach((a) => a.finish()); // a quick tap while it's still opening
        await opened;
      }
      if (state !== "open") return;
      state = "closing";

      const photo = imgOf(slides[1]);
      const thumb = thumbOf(index);
      const to = onScreen(thumb);
      if (reducedMotion()) return dialog.close();

      const ms = 280;
      running = [fade(scrim, 1, 0, ms), ...chrome.map((el) => fade(el, 1, 0, ms * 0.6))];
      if (to) {
        running.push(fly(photo.currentSrc || photo.src, photo.getBoundingClientRect(), to, false, ms));
        hide(photo, thumb);
      } else {
        running.push(fade(track, 1, 0, ms * 0.6));
      }
      try {
        await Promise.all(running.map((a) => a.finished));
      } catch {
        return; // cancelled: the dialog was closed some other way
      }
      dialog.close(); // the "close" handler below tidies up in the same frame
    };

    items.forEach(({ button, full }, i) => {
      // Start loading the large photo as soon as the finger/pointer lands.
      button.addEventListener("pointerdown", () => preload(full), { once: true });
      button.addEventListener("pointerenter", () => preload(full), { once: true });
      button.addEventListener("click", () => open(i));
    });

    dialog.querySelector(".close")!.addEventListener("click", close);
    // Escape: animate out instead of vanishing.
    dialog.addEventListener("cancel", (e) => {
      e.preventDefault();
      close();
    });
    dialog.addEventListener("close", () => {
      settle();
      state = "closed";
    });
    dialog.addEventListener("keydown", (e) => {
      if (e.key === "ArrowLeft") go(-1);
      if (e.key === "ArrowRight") go(1);
    });
    new ResizeObserver(() => {
      if (dialog.open && !animating) {
        measure();
        setOffset(0);
      }
    }).observe(track);

    // Swipe on phones: the strip follows your finger; a flick or a half-way drag moves on.
    let drag: { id: number; x: number; samples: { x: number; t: number }[] } | null = null;
    let moved = 0;

    // A click or tap anywhere but the photo closes, like clicking outside. Handled on `click`
    // rather than pointerup, so the tap can't fall through to the page underneath.
    dialog.addEventListener("pointerdown", () => (moved = 0), { capture: true });
    dialog.addEventListener("click", (e) => {
      if (moved >= 6) return; // that was a swipe
      if ((e.target as Element).closest(".close")) return; // has its own handler
      if (!(document.elementFromPoint(e.clientX, e.clientY) instanceof HTMLImageElement)) close();
    });

    track.addEventListener("pointerdown", (e) => {
      if (!e.isPrimary || e.button !== 0 || animating || state !== "open") return;
      try {
        track.setPointerCapture(e.pointerId);
      } catch {}
      measure();
      drag = { id: e.pointerId, x: e.clientX, samples: [{ x: e.clientX, t: performance.now() }] };
    });

    track.addEventListener("pointermove", (e) => {
      if (!drag || e.pointerId !== drag.id) return;
      const dx = e.clientX - drag.x;
      moved = Math.max(moved, Math.abs(dx));
      const t = performance.now();
      drag.samples.push({ x: e.clientX, t });
      while (drag.samples.length > 2 && drag.samples[0].t < t - 80) drag.samples.shift();
      setOffset(dx);
    });

    const release = (e: PointerEvent) => {
      if (!drag || e.pointerId !== drag.id) return;
      const dx = e.clientX - drag.x;
      const first = drag.samples[0];
      const last = drag.samples[drag.samples.length - 1];
      const velocity = (last.x - first.x) / Math.max(last.t - first.t, 16); // px per ms
      drag = null;

      if (moved < 6) {
        setOffset(0); // a tap: the click handler above decides whether to close
        return;
      }
      const projected = dx + velocity * 280;
      if (projected <= -width / 2) go(1, 260);
      else if (projected >= width / 2) go(-1, 260);
      else setOffset(0, 240);
    };
    track.addEventListener("pointerup", release);
    track.addEventListener("pointercancel", release);
  });
</script>

<style>
  /* Masonry: 2 columns on mobile, 3 on desktop; photos keep their aspect ratio. */
  .gallery {
    columns: 2;
    column-gap: 1rem;
  }

  @media (min-width: 768px) {
    .gallery {
      columns: 3;
      column-gap: 2.5rem;
    }
  }

  .thumb {
    display: block;
    width: 100%;
    margin-bottom: 1rem;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
    break-inside: avoid;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }

  @media (min-width: 768px) {
    .thumb {
      margin-bottom: 2.5rem;
    }
  }

  .thumb img {
    width: 100%;
  }

  .thumb:focus-visible {
    outline: 1px solid var(--muted);
    outline-offset: 4px;
  }

  /* Full-screen native <dialog>. Opening and closing are animated in the script: the photo
     flies to and from its thumbnail while the background fades. */
  .viewer {
    position: fixed;
    inset: 0;
    z-index: 100;
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--foreground-color);
    overflow: hidden;
    overscroll-behavior: contain;
    flex-direction: column;
  }

  .viewer[open] {
    display: flex;
  }

  /* The background, as its own layer so it can fade without the photo. */
  .scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--background-color);
  }

  .viewer:focus {
    outline: none;
  }

  .viewer::backdrop {
    background: transparent;
  }

  .top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 1.5rem 1.5rem 0;
    font-size: 13px;
  }

  .counter {
    color: var(--muted);
  }

  .close {
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    color: inherit;
    cursor: pointer;
    opacity: 0.5;
    transition: opacity 150ms;
    -webkit-tap-highlight-color: transparent;
  }

  .close:hover,
  .close:focus-visible {
    opacity: 1;
  }

  .close:focus-visible {
    outline: 1px solid var(--muted);
    outline-offset: 4px;
  }

  .track {
    position: relative;
    flex: 1;
    min-height: 0;
    margin: 1rem 0;
    overflow: hidden;
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
  }

  .slide {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 1.5rem;
    will-change: transform;
  }

  .slide img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    -webkit-user-drag: none;
  }

  .caption {
    max-width: 40rem;
    margin: 0 auto;
    padding: 0 1.5rem calc(1.5rem + env(safe-area-inset-bottom));
    text-align: center;
  }

  .caption .title {
    font-size: 13px;
  }

  .caption .description {
    font-size: 12px;
    line-height: 1.5;
    color: var(--muted);
  }
</style>
