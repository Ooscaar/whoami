---
import { Image } from "astro:assets";
import { photos } from "../data/gallery";
---

<div class="gallery">
  {
    photos.map((photo, i) => (
      <figure>
        <button
          type="button"
          class="thumb"
          data-index={i}
          data-full={photo.src.src}
          data-title={photo.title}
          data-description={photo.description}
          aria-label={`Open ${photo.title}`}
        >
          <Image
            src={photo.src}
            alt={photo.title}
            widths={[400, 800]}
            sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
            loading={i < 3 ? "eager" : "lazy"}
          />
        </button>
        <figcaption>{photo.title}</figcaption>
      </figure>
    ))
  }
</div>

<dialog class="lightbox" aria-label="Photo">
  <button type="button" class="close" aria-label="Close">close</button>
  <img alt="" />
  <div class="details">
    <p class="title"></p>
    <p class="description"></p>
  </div>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>(".lightbox")!;
  const img = dialog.querySelector("img")!;
  const title = dialog.querySelector(".title")!;
  const description = dialog.querySelector(".description")!;

  document.querySelectorAll<HTMLButtonElement>(".gallery .thumb").forEach((thumb) => {
    thumb.addEventListener("click", () => {
      const { full = "", title: t = "", description: d = "" } = thumb.dataset;
      img.src = full;
      img.alt = t;
      title.textContent = t;
      description.textContent = d;
      dialog.showModal();
    });
  });

  dialog.querySelector(".close")!.addEventListener("click", () => dialog.close());
  // Clicking the backdrop (outside the content) closes it.
  dialog.addEventListener("click", (e) => {
    if (e.target === dialog) dialog.close();
  });
</script>

<style>
  /* Masonry: columns keep each photo's natural aspect ratio. */
  .gallery {
    columns: 3 240px;
    column-gap: 1.25rem;
  }

  figure {
    break-inside: avoid;
    margin-bottom: 1.5rem;
  }

  .thumb {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
    overflow: hidden;
  }

  .thumb img {
    width: 100%;
    transition: transform 500ms ease-out;
  }

  .thumb:hover img,
  .thumb:focus-visible img {
    transform: scale(1.02);
  }

  figcaption {
    margin-top: 0.75rem;
    font-size: 12px;
    line-height: 1.4;
    color: var(--muted);
  }

  .lightbox {
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 3rem 1.5rem 2rem;
    border: 0;
    background: var(--background-color);
    color: var(--foreground-color);
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1.25rem;
  }

  .lightbox[open] {
    display: flex;
  }

  .lightbox::backdrop {
    background: transparent;
  }

  .lightbox img {
    max-width: min(100%, 1200px);
    max-height: calc(100dvh - 12rem);
    width: auto;
    object-fit: contain;
  }

  .details {
    width: min(100%, 1200px);
    text-align: center;
  }

  .details .title {
    font-size: 13px;
  }

  .details .description {
    font-size: 12px;
    color: var(--muted);
  }

  .close {
    position: absolute;
    top: 1.5rem;
    right: 1.5rem;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    font-size: 13px;
    color: inherit;
    cursor: pointer;
    opacity: 0.5;
    transition: opacity 150ms;
  }

  .close:hover,
  .close:focus-visible {
    opacity: 1;
  }
</style>
