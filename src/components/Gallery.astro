---
import { Image, getImage } from "astro:assets";
import { photos } from "../data/gallery";

// Optimized large versions for the viewer (instead of the original files).
const large = await Promise.all(
  photos.map((photo) => getImage({ src: photo.src, width: 1600, format: "webp" })),
);
---

<div class="gallery">
  {
    photos.map((photo, i) => (
      <figure>
        <button
          type="button"
          class="thumb"
          data-index={i}
          data-full={large[i].src}
          data-title={photo.title}
          data-description={photo.description}
          aria-label={`Open ${photo.title}`}
        >
          <Image
            src={photo.src}
            alt={photo.title}
            widths={[400, 800]}
            sizes="(max-width: 520px) 100vw, (max-width: 760px) 50vw, 330px"
            loading={i < 3 ? "eager" : "lazy"}
          />
        </button>
        <figcaption>{photo.title}</figcaption>
      </figure>
    ))
  }
</div>

<dialog class="lightbox" aria-label="Photo viewer" closedby="any" tabindex="-1">
  <div class="bar">
    <span class="counter"></span>
    <button type="button" class="close" aria-label="Close">close</button>
  </div>
  <div class="stage">
    <button type="button" class="step prev" aria-label="Previous photo">←</button>
    <img alt="" />
    <button type="button" class="step next" aria-label="Next photo">→</button>
  </div>
  <div class="details">
    <p class="title"></p>
    <p class="description"></p>
  </div>
</dialog>

<script>
  // Runs on every client-side navigation (ClientRouter), not just the first load.
  document.addEventListener("astro:page-load", () => {
    const dialog = document.querySelector<HTMLDialogElement>(".lightbox");
    if (!dialog) return;

    const thumbs = [...document.querySelectorAll<HTMLButtonElement>(".gallery .thumb")];
    const img = dialog.querySelector("img")!;
    const counter = dialog.querySelector(".counter")!;
    const title = dialog.querySelector(".title")!;
    const description = dialog.querySelector(".description")!;
    let index = 0;

    const show = (i: number) => {
      index = (i + thumbs.length) % thumbs.length;
      const thumb = thumbs[index];
      const { full = "", title: t = "", description: d = "" } = thumb.dataset;

      // Show the already-loaded thumbnail instantly, then swap in the large version.
      img.src = thumb.querySelector("img")?.currentSrc ?? full;
      img.alt = t;
      const hiRes = new Image();
      hiRes.onload = () => {
        if (index === thumbs.indexOf(thumb)) img.src = full;
      };
      hiRes.src = full;

      counter.textContent = `${index + 1} / ${thumbs.length}`;
      title.textContent = t;
      description.textContent = d;
    };

    thumbs.forEach((thumb, i) =>
      thumb.addEventListener("click", () => {
        show(i);
        dialog.showModal();
        // Focus the dialog itself so no button shows a focus ring on open.
        dialog.focus();
      }),
    );

    dialog.querySelector(".close")!.addEventListener("click", () => dialog.close());
    dialog.querySelector(".prev")!.addEventListener("click", () => show(index - 1));
    dialog.querySelector(".next")!.addEventListener("click", () => show(index + 1));
    dialog.addEventListener("keydown", (e) => {
      if (e.key === "ArrowLeft") show(index - 1);
      if (e.key === "ArrowRight") show(index + 1);
    });
    // Clicking empty space (not the photo or controls) closes it.
    dialog.addEventListener("click", (e) => {
      const target = e.target as HTMLElement;
      if (target === dialog || target.classList.contains("stage")) dialog.close();
    });
  });
</script>

<style>
  /* Masonry: columns keep each photo's natural aspect ratio. */
  .gallery {
    columns: 3 220px;
    column-gap: 1rem;
  }

  figure {
    break-inside: avoid;
    margin-bottom: 1.5rem;
  }

  .thumb {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
    overflow: hidden;
  }

  .thumb img {
    width: 100%;
    transition: transform 500ms ease-out;
  }

  .thumb:hover img,
  .thumb:focus-visible img {
    transform: scale(1.02);
  }

  figcaption {
    margin-top: 0.75rem;
    font-size: 12px;
    line-height: 1.4;
    color: var(--muted);
  }

  /* Native <dialog> viewer: fades in, photo rises slightly. */
  .lightbox {
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 1.5rem;
    border: 0;
    background: var(--background-color);
    color: var(--foreground-color);
    flex-direction: column;
    gap: 1.25rem;
    opacity: 0;
    transition:
      opacity 200ms ease-out,
      display 200ms allow-discrete,
      overlay 200ms allow-discrete;
  }

  .lightbox[open] {
    display: flex;
    opacity: 1;
  }

  @starting-style {
    .lightbox[open] {
      opacity: 0;
    }
  }

  .lightbox:focus {
    outline: none;
  }

  .close:focus-visible,
  .step:focus-visible {
    outline: 1px solid var(--muted);
    outline-offset: 4px;
  }

  .lightbox::backdrop {
    background: transparent;
  }

  .lightbox img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    min-height: 0;
    object-fit: contain;
    transition: transform 300ms ease-out;
  }

  @starting-style {
    .lightbox[open] img {
      transform: translateY(8px) scale(0.98);
    }
  }

  .bar {
    display: flex;
    justify-content: space-between;
    font-size: 13px;
  }

  .counter {
    color: var(--muted);
  }

  .stage {
    flex: 1;
    min-height: 0;
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr) 3rem;
    grid-template-rows: minmax(0, 1fr);
    align-items: center;
    justify-items: center;
  }

  .details {
    max-width: 40rem;
    margin: 0 auto;
    text-align: center;
  }

  .details .title {
    font-size: 13px;
  }

  .details .description {
    font-size: 12px;
    line-height: 1.5;
    color: var(--muted);
  }

  .close,
  .step {
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    color: inherit;
    cursor: pointer;
    opacity: 0.5;
    transition: opacity 150ms;
  }

  .step {
    font-size: 15px;
    width: 3rem;
    height: 3rem;
  }

  .close:hover,
  .close:focus-visible,
  .step:hover,
  .step:focus-visible {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .lightbox,
    .lightbox img {
      transition: none;
    }
  }
</style>
