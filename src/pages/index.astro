---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import me from "../assets/me.jpg";

const links = [
  { label: "github", href: "https://github.com/Ooscaar" },
  { label: "linkedin", href: "https://www.linkedin.com/in/oscarperezcastillo/" },
  { label: "x", href: "https://x.com/ooscaar999" },
];
---

<Layout title="Òscar Pérez">
  <section class="about">
    <!-- The text leads on the left; the photo is a small aside on the right. -->
    <div class="text">
      <h1>Hi, I'm Òscar.</h1>
      <p>
        I'm a software developer based in Barcelona. Right now I work at{" "}
        <a href="https://zernio.com" target="_blank" rel="noopener noreferrer">Zernio</a>.
      </p>
      <p>
        Before that, I was at{" "}
        <a href="https://eseleos.com" target="_blank" rel="noopener noreferrer">Eseleos</a>.
      </p>
      <p>
        {
          links.map((link, i) => (
            <span>
              {i > 0 && <span class="sep"> / </span>}
              <a href={link.href} target="_blank" rel="noopener noreferrer">
                {link.label}
              </a>
            </span>
          ))
        }
      </p>
    </div>

    <Image
      class="me"
      src={me}
      alt="Òscar Pérez on the sand dunes"
      width={64}
      height={64}
      densities={[1, 2, 3]}
      loading="eager"
    />
  </section>
</Layout>

<style>
  .about {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 2rem;
    align-items: start;
  }

  h1 {
    font-weight: 500;
  }

  .text p {
    margin-top: 1rem;
  }

  /* Small and secondary: black and white until hovered or tapped. */
  .me {
    width: 64px;
    height: 64px;
    margin-top: 0.25rem;
    border-radius: 2px;
    filter: grayscale(1);
    opacity: 0.8;
    transition:
      filter 500ms ease,
      opacity 500ms ease;
    -webkit-tap-highlight-color: transparent;
  }

  .me:hover,
  .me:active {
    filter: none;
    opacity: 1;
  }

  @media (max-width: 480px) {
    .about {
      gap: 1.25rem;
    }

    .me {
      width: 48px;
      height: 48px;
    }
  }

  .sep {
    opacity: 0.4;
  }
</style>
