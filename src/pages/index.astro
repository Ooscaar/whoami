---
import { Font } from "astro:assets";

const title = "Hello World";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <Font cssVariable="--font-geist-mono" preload />
  </head>
  <body>
    <h1>{title}</h1>
  </body>
</html>

<style>
  body {
    margin: 0;
    min-height: 100vh;
    display: grid;
    place-items: center;
    font-family: var(--font-geist-mono);
  }
</style>
