---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import me from "../assets/me.jpg";

const links = [
  { label: "github", href: "https://github.com/Ooscaar" },
  { label: "linkedin", href: "https://www.linkedin.com/in/oscarperezcastillo/" },
  { label: "x", href: "https://x.com/ooscaar999" },
];
---

<Layout title="Òscar Pérez">
  <section class="about">
    <div class="me">
      <Image src={me} alt="Òscar Pérez" width={96} height={96} densities={[1, 2, 3]} loading="eager" />
    </div>
    <h1>Hi, I'm Òscar.</h1>
    <!-- Placeholder copy: replace the [bracketed] parts. -->
    <p>
      I'm a [role] based in [city]. Right now I work at{" "}
      <a href="#" target="_blank" rel="noopener noreferrer">[company]</a>, where I [what you do
      there].
    </p>
    <p>
      I started working in [year], when I [how it began: first job, first project]. Since then
      I've [a line about the path so far].
    </p>
    <p>
      {
        links.map((link, i) => (
          <span>
            {i > 0 && <span class="sep"> / </span>}
            <a href={link.href} target="_blank" rel="noopener noreferrer">
              {link.label}
            </a>
          </span>
        ))
      }
    </p>
  </section>
</Layout>

<style>
  .about {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  /* A little polaroid: tilted, straightens (and wiggles) on hover or tap. */
  .me {
    width: fit-content;
    margin-bottom: 1rem;
    padding: 4px;
    background: #fff;
    border-radius: 3px;
    box-shadow:
      0 1px 2px color-mix(in srgb, var(--foreground-color) 10%, transparent),
      0 6px 16px -6px color-mix(in srgb, var(--foreground-color) 25%, transparent);
    rotate: -4deg;
    transition: rotate 400ms cubic-bezier(0.34, 1.56, 0.64, 1), scale 400ms cubic-bezier(0.34, 1.56, 0.64, 1);
    -webkit-tap-highlight-color: transparent;
  }

  .me:hover,
  .me:active {
    rotate: 2deg;
    scale: 1.06;
  }

  .me img {
    display: block;
    width: 96px;
    height: 96px;
    border-radius: 1px;
  }

  @media (prefers-reduced-motion: reduce) {
    .me {
      transition: none;
    }
  }

  .sep {
    opacity: 0.4;
  }
</style>
