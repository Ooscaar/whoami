---
import Layout from "../layouts/Layout.astro";

const links = [
  { label: "github", href: "https://github.com/Ooscaar" },
  { label: "linkedin", href: "https://www.linkedin.com/in/oscarperezcastillo/" },
  { label: "x", href: "https://x.com/ooscaar999" },
];
---

<Layout title="Òscar Pérez">
  <header>
    <p class="muted">hello world<span class="cursor" aria-hidden="true"></span></p>
  </header>

  <section class="about">
    <h1>Hi, I'm Òscar.</h1>
    <!-- Placeholder copy: replace the [bracketed] parts. -->
    <p>
      I'm a [role] based in [city]. Right now I work at{" "}
      <a href="#" target="_blank" rel="noopener noreferrer">[company]</a>, where I [what you do
      there].
    </p>
    <p>
      I started working in [year], when I [how it began: first job, first project]. Since then
      I've [a line about the path so far].
    </p>
    <p>
      {
        links.map((link, i) => (
          <span>
            {i > 0 && <span class="sep"> / </span>}
            <a href={link.href} target="_blank" rel="noopener noreferrer">
              {link.label}
            </a>
          </span>
        ))
      }
    </p>
  </section>

  <footer class="muted">© {new Date().getFullYear()} Òscar Pérez</footer>
</Layout>

<style>
  header {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .cursor {
    display: inline-block;
    width: 0.55em;
    height: 1em;
    margin-left: 0.25rem;
    translate: 0 0.15em;
    background: currentColor;
    animation: blink 1.1s steps(1) infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cursor {
      animation: none;
    }
  }

  .about {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .sep {
    opacity: 0.4;
  }

  footer {
    font-size: 12px;
  }
</style>
