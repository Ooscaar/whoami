---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import me from "../assets/me.jpg";

const links = [
  { label: "github", href: "https://github.com/Ooscaar" },
  { label: "linkedin", href: "https://www.linkedin.com/in/oscarperezcastillo/" },
  { label: "x", href: "https://x.com/ooscaar999" },
];
---

<Layout title="Òscar Pérez">
  <section class="about">
    <Image
      class="me"
      src={me}
      alt="Òscar Pérez on the sand dunes"
      width={88}
      height={88}
      densities={[1, 2, 3]}
      loading="eager"
    />
    <h1>Hi, I'm Òscar.</h1>
    <!-- Placeholder copy: replace the [bracketed] parts. -->
    <p>
      I'm a [role] based in [city]. Right now I work at{" "}
      <a href="#" target="_blank" rel="noopener noreferrer">[company]</a>, where I [what you do
      there].
    </p>
    <p>
      I started working in [year], when I [how it began: first job, first project]. Since then
      I've [a line about the path so far].
    </p>
    <p>
      {
        links.map((link, i) => (
          <span>
            {i > 0 && <span class="sep"> / </span>}
            <a href={link.href} target="_blank" rel="noopener noreferrer">
              {link.label}
            </a>
          </span>
        ))
      }
    </p>
  </section>
</Layout>

<style>
  .about {
    display: flow-root; /* contain the floated photo */
  }

  .about p {
    margin-top: 1rem;
  }

  /* Small and secondary: floats beside the intro, black and white until hovered or tapped. */
  .me {
    float: right;
    width: 88px;
    height: 88px;
    margin: 0.25rem 0 0.5rem 1.5rem;
    border-radius: 2px;
    filter: grayscale(1);
    opacity: 0.85;
    transition:
      filter 500ms ease,
      opacity 500ms ease;
    -webkit-tap-highlight-color: transparent;
  }

  .me:hover,
  .me:active {
    filter: none;
    opacity: 1;
  }

  @media (max-width: 480px) {
    .me {
      width: 64px;
      height: 64px;
      margin-left: 1rem;
    }
  }

  .sep {
    opacity: 0.4;
  }
</style>
