---
// Rendered on each request from D1, which the Strava webhook + daily cron keep up to date
// (src/lib/strava/sync.ts). Visitors never trigger a Strava API call. Anonymised: only sport,
// date and effort are stored and shown (no names, routes or locations).
import { env } from "cloudflare:workers";
import Layout from "../layouts/Layout.astro";
import SportIcon from "../components/SportIcon.astro";
import {
  dayTotals,
  recentActivities,
  yearTotals,
  type Activity,
  type DayTotals,
  type YearTotals,
} from "../lib/strava/store.ts";
import { formatDate, formatDistance, formatDuration, formatPace, MONTHS, sportLabel } from "../lib/strava/format.ts";

export const prerender = false;

const now = new Date();
const year = now.getUTCFullYear();
const today = now.toISOString().slice(0, 10);

// EXPERIMENT (local only): ?shade=time (default) | distance | sport
const shade = Astro.url.searchParams.get("shade") ?? "time";
let daySports: { day: string; sport_type: string; moving_time: number }[] = [];

let latest: Activity[] = [];
let sports: YearTotals[] = [];
let days: DayTotals[] = [];
try {
  [latest, sports, days] = await Promise.all([recentActivities(env.DB, 8), yearTotals(env.DB, year), dayTotals(env.DB, year)]);
  daySports = (
    await env.DB.prepare(
      `SELECT substr(start_date_local, 1, 10) AS day, sport_type, sum(moving_time) AS moving_time
       FROM activities WHERE substr(start_date_local, 1, 4) = ?1 GROUP BY day, sport_type`,
    )
      .bind(String(year))
      .all<{ day: string; sport_type: string; moving_time: number }>()
  ).results;
} catch (error) {
  // No DB binding (plain `astro dev`) or no tables yet (before the first sync).
  console.warn("activities: couldn't read D1:", error);
}

const total = sports.reduce(
  (sum, s) => ({
    count: sum.count + s.count,
    distance: sum.distance + s.distance,
    time: sum.time + s.moving_time,
    elevation: sum.elevation + s.elevation,
  }),
  { count: 0, distance: 0, time: 0, elevation: 0 },
);

// One small GitHub-style calendar per month: a column per week (Monday first), a square per day.
const CELL = 9;
const GAP = 3;
const byDay = new Map(days.map((d) => [d.day, d]));
const level = (seconds: number) => (seconds < 30 * 60 ? 1 : seconds < 60 * 60 ? 2 : seconds < 2 * 3600 ? 3 : 4);
const distanceLevel = (m: number) => (m < 10_000 ? 1 : m < 25_000 ? 2 : m < 50_000 ? 3 : 4);
// Muted, earthy colours that sit on the off-white background.
const SPORT_COLORS: Record<string, string> = {
  AlpineSki: "#5b6b8c", BackcountrySki: "#5b6b8c", NordicSki: "#5b6b8c", Snowboard: "#5b6b8c",
  Ride: "#b5653a", MountainBikeRide: "#b5653a", GravelRide: "#b5653a", EBikeRide: "#b5653a", VirtualRide: "#b5653a",
  Run: "#a8423f", TrailRun: "#a8423f", Walk: "#7a8450", Hike: "#7a8450",
  Swim: "#3f8a8c", Tennis: "#a68a3a",
};
const sportColor = (sport: string) => SPORT_COLORS[sport] ?? "#262523";
const mainSport = new Map<string, string>();
for (const row of [...daySports].sort((a, b) => a.moving_time - b.moving_time)) mainSport.set(row.day, row.sport_type);
const months = Array.from({ length: 12 }, (_, month) => {
  const first = new Date(Date.UTC(year, month, 1));
  const length = new Date(Date.UTC(year, month + 1, 0)).getUTCDate();
  const offset = (first.getUTCDay() + 6) % 7;
  const cells = Array.from({ length }, (_, i) => {
    const date = new Date(Date.UTC(year, month, i + 1));
    const key = date.toISOString().slice(0, 10);
    const totals = byDay.get(key);
    const label = formatDate(key, now);
    return {
      x: Math.floor((offset + i) / 7) * (CELL + GAP),
      y: ((offset + i) % 7) * (CELL + GAP),
      level: !totals ? 0 : shade === "distance" ? (totals.distance > 0 ? distanceLevel(totals.distance) : 1) : level(totals.moving_time),
      color: totals && shade === "sport" ? sportColor(mainSport.get(key)!) : undefined,
      future: key > today,
      title: totals
        ? `${label} · ${totals.sports.split(",").map(sportLabel).join(", ")} · ${formatDuration(totals.moving_time)}${totals.distance > 0 ? ` · ${formatDistance(totals.distance)}` : ""}`
        : label,
    };
  });
  const active = days.filter((d) => Number(d.day.slice(5, 7)) === month + 1);
  return {
    name: MONTHS[month],
    width: Math.ceil((offset + length) / 7) * (CELL + GAP) - GAP,
    cells,
    count: active.reduce((sum, d) => sum + d.count, 0),
    time: active.reduce((sum, d) => sum + d.moving_time, 0),
    future: month > now.getUTCMonth(),
  };
});
const HEIGHT = 7 * (CELL + GAP) - GAP;
const meters = (m: number) => `${Math.round(m).toLocaleString("en-GB")} m up`;

Astro.response.headers.set("Cache-Control", "public, max-age=300");
---

<Layout title="Activities — Òscar Pérez" description="Òscar Pérez's year in training">
  <header>
    <h1>activities</h1>
    <p class="muted">my {year} in training, from strava. a square per day, darker means longer.</p>
  </header>

  {
    total.count === 0 ? (
      <p class="muted">no activities yet.</p>
    ) : (
      <>
        <section class="overview" aria-label={`${year} so far`}>
          <p class="summary">
            <span class="nowrap">{total.count} activities</span> · <span class="nowrap">{formatDistance(total.distance)}</span> ·{" "}
            <span class="nowrap">{formatDuration(total.time)}</span>
            {total.elevation >= 1 && <> · <span class="nowrap">{meters(total.elevation)}</span></>}
          </p>

          <ol class="months">
            {months.map((m) => (
              <li class:list={{ future: m.future }}>
                <span class="month-name">{m.name}</span>
                <svg width={m.width} height={HEIGHT} viewBox={`0 0 ${m.width} ${HEIGHT}`} role="img" aria-label={`${m.name}: ${m.count} activities`}>
                  {m.cells.map((c) => (
                    <rect x={c.x} y={c.y} width={CELL} height={CELL} rx="1.5" class={c.future ? "future" : `l${c.level}`} style={c.color ? `fill: ${c.color}` : undefined}>
                      <title>{c.title}</title>
                    </rect>
                  ))}
                </svg>
                <span class="month-total muted">{m.count > 0 ? `${m.count}× · ${formatDuration(m.time)}` : m.future ? "" : "—"}</span>
              </li>
            ))}
          </ol>

          {shade === "sport" && (
            <p class="legend muted" aria-hidden="true">
              {sports.map((s) => (
                <span class="sport-key">
                  <svg width={CELL} height={CELL} viewBox={`0 0 ${CELL} ${CELL}`}>
                    <rect width={CELL} height={CELL} rx="1.5" class="l4" style={`fill: ${sportColor(s.sport_type)}`} />
                  </svg>
                  {sportLabel(s.sport_type)}
                </span>
              ))}
            </p>
          )}
          <p class="legend muted" aria-hidden="true">
            less
            {[0, 1, 2, 3, 4].map((l) => (
              <svg width={CELL} height={CELL} viewBox={`0 0 ${CELL} ${CELL}`}>
                <rect width={CELL} height={CELL} rx="1.5" class={`l${l}`} />
              </svg>
            ))}
            more
          </p>
        </section>

        <section aria-labelledby="by-sport">
          <h2 id="by-sport" class="muted">by sport</h2>
          <ul class="rows">
            {sports.map((s) => (
              <li>
                <span class="sport">
                  <SportIcon sport={s.sport_type} color={shade === "sport" ? sportColor(s.sport_type) : undefined} />
                  {sportLabel(s.sport_type)}
                </span>
                <span class="muted">
                  {s.count}× · {s.distance > 0 && `${formatDistance(s.distance)} · `}
                  {formatDuration(s.moving_time)}
                  {s.elevation >= 1 && ` · ${meters(s.elevation)}`}
                </span>
              </li>
            ))}
          </ul>
        </section>

        <section aria-labelledby="latest">
          <h2 id="latest" class="muted">latest</h2>
          <ul class="rows">
            {latest.map((a) => {
              const pace = a.distance > 0 ? formatPace(a.sport_type, a.average_speed) : null;
              return (
                <li>
                  <span class="sport">
                    <span class="date muted">{formatDate(a.start_date_local)}</span>
                    <SportIcon sport={a.sport_type} color={shade === "sport" ? sportColor(a.sport_type) : undefined} />
                    {sportLabel(a.sport_type)}
                  </span>
                  <span class="muted">
                    {a.distance > 0 && `${formatDistance(a.distance)} · `}
                    {formatDuration(a.moving_time)}
                    {pace && ` · ${pace}`}
                  </span>
                </li>
              );
            })}
          </ul>
        </section>
      </>
    )
  }

  <p class="credits muted">Powered by Strava</p>
</Layout>

<style>
  section {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .overview {
    gap: var(--space-4);
  }

  h2 {
    font-size: var(--small);
  }

  ul,
  ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nowrap {
    white-space: nowrap;
  }

  /* Twelve small month calendars. */
  .months {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-4) var(--space-3);
  }

  .months li {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .months li.future {
    opacity: 0.5;
  }

  .month-name,
  .month-total {
    font-size: var(--small);
    line-height: 1.5;
  }

  .month-total {
    min-height: 1.5em;
    font-variant-numeric: tabular-nums;
  }

  svg {
    display: block;
    overflow: visible;
  }

  /* Squares: faint when empty, then darker with more time that day. */
  rect {
    fill: var(--foreground-color);
  }

  .l0 {
    fill-opacity: 0.07;
  }

  .l1 {
    fill-opacity: 0.25;
  }

  .l2 {
    fill-opacity: 0.45;
  }

  .l3 {
    fill-opacity: 0.7;
  }

  .l4 {
    fill-opacity: 0.95;
  }

  rect.future {
    fill-opacity: 0.03;
  }

  .legend {
    display: flex;
    align-items: center;
    gap: 3px;
    font-size: var(--small);
  }

  .sport-key {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    margin-right: 0.75rem;
  }

  .legend svg:first-of-type {
    margin-left: 0.25rem;
  }

  .legend svg:last-of-type {
    margin-right: 0.25rem;
  }

  .rows li {
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-2) 0;
    border-top: var(--hairline);
  }

  .rows li:last-child {
    border-bottom: var(--hairline);
  }

  .rows li > .muted {
    text-align: right;
    font-variant-numeric: tabular-nums;
  }

  .sport {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  .date {
    display: inline-block;
    min-width: 4.5rem;
  }

  .credits {
    font-size: var(--small);
    line-height: 1.5;
  }

  @media (max-width: 480px) {
    .months {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    /* Label on top, numbers underneath, instead of both squeezed onto one line. */
    .rows li {
      flex-direction: column;
      gap: 0;
    }

    .rows li > .muted {
      text-align: left;
      font-size: var(--small);
      line-height: 1.5;
    }
  }
</style>
