---
// Rendered on each request from D1, which the Strava webhook + daily cron keep up to date
// (src/lib/strava/sync.ts). Visitors never trigger a Strava API call. Anonymised: only sport,
// date and effort are stored and shown (no names, routes or locations).
import { env } from "cloudflare:workers";
import Layout from "../layouts/Layout.astro";
import SportIcon from "../components/SportIcon.astro";
import {
  activityYears,
  dayTotals,
  recentActivities,
  yearTotals,
  type Activity,
  type DayTotals,
  type YearTotals,
} from "../lib/strava/store.ts";
import {
  formatDate,
  formatDistance,
  formatDuration,
  formatElevation,
  formatPace,
  MONTHS,
  sportLabel,
} from "../lib/strava/format.ts";

export const prerender = false;

const now = new Date();
const currentYear = now.getUTCFullYear();
const today = now.toISOString().slice(0, 10);

// ?year=2025 picks the year; anything else (or a year without activities) falls back to the
// current year, or the newest one with data.
let years: number[] = [];
let year = currentYear;
let latest: Activity[] = [];
let totals: YearTotals[] = [];
let days: DayTotals[] = [];
try {
  years = await activityYears(env.DB);
  const requested = Number(Astro.url.searchParams.get("year"));
  year = years.includes(requested) ? requested : years.includes(currentYear) ? currentYear : (years[0] ?? currentYear);
  [latest, totals, days] = await Promise.all([
    recentActivities(env.DB, 8, year),
    yearTotals(env.DB, year),
    dayTotals(env.DB, year),
  ]);
} catch (error) {
  // No DB binding (plain `astro dev`) or no tables yet (before the first sync).
  console.warn("activities: couldn't read D1:", error);
}
// Dates show without the year when it's the selected one ("3 mar", not "3 mar 2025").
const yearStart = new Date(Date.UTC(year, 0, 1));

// One row per sport as shown: Ride, MountainBikeRide, GravelRide… all add up under "mtb".
interface SportRow {
  label: string;
  sportType: string;
  count: number;
  distance: number;
  time: number;
  elevation: number;
}
const bySport = new Map<string, SportRow>();
for (const t of totals) {
  const label = sportLabel(t.sport_type);
  const row = bySport.get(label) ?? { label, sportType: t.sport_type, count: 0, distance: 0, time: 0, elevation: 0 };
  row.count += t.count;
  row.distance += t.distance;
  row.time += t.moving_time;
  row.elevation += t.elevation;
  bySport.set(label, row);
}
const sports = [...bySport.values()].sort((a, b) => b.time - a.time);

const total = sports.reduce(
  (sum, s) => ({
    count: sum.count + s.count,
    distance: sum.distance + s.distance,
    time: sum.time + s.time,
    elevation: sum.elevation + s.elevation,
  }),
  { count: 0, distance: 0, time: 0, elevation: 0 },
);

// One small GitHub-style calendar per month: a column per week (Monday first), a square per day.
const CELL = 9;
const GAP = 3;
const HEIGHT = 7 * (CELL + GAP) - GAP;
const byDay = new Map(days.map((d) => [d.day, d]));
const level = (seconds: number) => (seconds < 30 * 60 ? 1 : seconds < 60 * 60 ? 2 : seconds < 2 * 3600 ? 3 : 4);
const months = Array.from({ length: 12 }, (_, month) => {
  const first = new Date(Date.UTC(year, month, 1));
  const length = new Date(Date.UTC(year, month + 1, 0)).getUTCDate();
  const offset = (first.getUTCDay() + 6) % 7;
  const cells = Array.from({ length }, (_, i) => {
    const key = new Date(Date.UTC(year, month, i + 1)).toISOString().slice(0, 10);
    const day = byDay.get(key);
    const label = formatDate(key, yearStart);
    const sportsThatDay = day ? [...new Set(day.sports.split(",").map(sportLabel))].join(", ") : "";
    return {
      x: Math.floor((offset + i) / 7) * (CELL + GAP),
      y: ((offset + i) % 7) * (CELL + GAP),
      level: day ? level(day.moving_time) : 0,
      future: key > today,
      title: day ? `${label} · ${sportsThatDay} · ${formatDuration(day.moving_time)}` : label,
    };
  });
  const active = days.filter((d) => Number(d.day.slice(5, 7)) === month + 1);
  return {
    name: MONTHS[month],
    width: Math.ceil((offset + length) / 7) * (CELL + GAP) - GAP,
    cells,
    count: active.reduce((sum, d) => sum + d.count, 0),
    time: active.reduce((sum, d) => sum + d.moving_time, 0),
    future: year > currentYear || (year === currentYear && month > now.getUTCMonth()),
  };
});

Astro.response.headers.set("Cache-Control", "public, max-age=300");
---

<Layout title="Activities — Òscar Pérez" description="Òscar Pérez's year in training">
  <header>
    <h1>activities</h1>
    <p class="muted">my {year} in training, from strava. a square per day, darker means longer.</p>
  </header>

  {
    total.count === 0 ? (
      <p class="muted">no activities yet.</p>
    ) : (
      <>
        <section class="overview" aria-label={`${year} overview`}>
          <dl class="stats">
            <div>
              <dt>activities</dt>
              <dd>{total.count}</dd>
            </div>
            <div>
              <dt>distance</dt>
              <dd>{formatDistance(total.distance)}</dd>
            </div>
            <div>
              <dt>time</dt>
              <dd>{formatDuration(total.time)}</dd>
            </div>
            <div>
              <dt>elevation</dt>
              <dd>{formatElevation(total.elevation)}</dd>
            </div>
          </dl>

          <ol class="months">
            {months.map((m) => (
              <li class:list={{ future: m.future }}>
                <span class="label">{m.name}</span>
                <svg width={m.width} height={HEIGHT} viewBox={`0 0 ${m.width} ${HEIGHT}`} role="img" aria-label={`${m.name}: ${m.count} activities`}>
                  {m.cells.map((c) => (
                    <rect x={c.x} y={c.y} width={CELL} height={CELL} rx="1.5" class={c.future ? "future" : `l${c.level}`}>
                      <title>{c.title}</title>
                    </rect>
                  ))}
                </svg>
                <span class="label muted">{m.count > 0 ? formatDuration(m.time) : m.future ? "" : "—"}</span>
              </li>
            ))}
          </ol>

          <div class="calendar-footer">
            {years.length > 1 && (
              <nav class="years" aria-label="Year">
                {years.map((y) => (
                  <a href={y === currentYear ? "/activities" : `/activities?year=${y}`} aria-current={y === year ? "page" : undefined}>
                    {y}
                  </a>
                ))}
              </nav>
            )}
            <p class="legend" aria-hidden="true">
              less
              {[0, 1, 2, 3, 4].map((l) => (
                <svg width={CELL} height={CELL} viewBox={`0 0 ${CELL} ${CELL}`}>
                  <rect width={CELL} height={CELL} rx="1.5" class={`l${l}`} />
                </svg>
              ))}
              more
            </p>
          </div>
        </section>

        <section aria-labelledby="by-sport">
          <h2 id="by-sport">by sport</h2>
          <table>
            <thead>
              <tr>
                <th scope="col">sport</th>
                <th scope="col" class="num">activities</th>
                <th scope="col" class="num">distance</th>
                <th scope="col" class="num">time</th>
                <th scope="col" class="num optional">elevation</th>
              </tr>
            </thead>
            <tbody>
              {sports.map((s) => (
                <tr>
                  <th scope="row">
                    <span class="sport">
                      <SportIcon sport={s.sportType} />
                      {s.label}
                    </span>
                  </th>
                  <td class="num">{s.count}</td>
                  <td class="num">{s.distance > 0 ? formatDistance(s.distance) : "—"}</td>
                  <td class="num">{formatDuration(s.time)}</td>
                  <td class="num optional">{s.elevation >= 1 ? formatElevation(s.elevation) : "—"}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </section>

        <section aria-labelledby="latest">
          <h2 id="latest">{year === currentYear ? "latest" : `last of ${year}`}</h2>
          <table>
            <thead>
              <tr>
                <th scope="col">date</th>
                <th scope="col">sport</th>
                <th scope="col" class="num">distance</th>
                <th scope="col" class="num">time</th>
                <th scope="col" class="num optional">pace</th>
              </tr>
            </thead>
            <tbody>
              {latest.map((a) => (
                <tr>
                  <td class="muted">{formatDate(a.start_date_local, yearStart)}</td>
                  <th scope="row">
                    <span class="sport">
                      <SportIcon sport={a.sport_type} />
                      {sportLabel(a.sport_type)}
                    </span>
                  </th>
                  <td class="num">{a.distance > 0 ? formatDistance(a.distance) : "—"}</td>
                  <td class="num">{formatDuration(a.moving_time)}</td>
                  <td class="num optional">{(a.distance > 0 && formatPace(a.sport_type, a.average_speed)) || "—"}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </section>
      </>
    )
  }

  <p class="credits">Powered by Strava</p>
</Layout>

<style>
  /* Two text sizes only: body text for values, 12px muted for every label and heading. */
  header,
  section {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .overview {
    gap: var(--space-4);
  }

  h2,
  dt,
  th[scope="col"],
  .label,
  .legend,
  .credits {
    font-size: 12px;
    line-height: 1.5;
    font-weight: inherit;
    color: var(--muted);
  }

  /* Month names read as labels, but in the text colour so the grid has anchors. */
  .label:not(.muted) {
    color: inherit;
  }

  h2 {
    margin-bottom: var(--space-2);
  }

  .num {
    text-align: right;
    font-variant-numeric: tabular-nums;
  }

  /* Key numbers for the year. */
  .stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-3);
    margin: 0;
  }

  .stats dd {
    margin: 0;
    font-variant-numeric: tabular-nums;
  }

  /* Twelve small month calendars. */
  .months {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-4) var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .months li {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .months li.future {
    opacity: 0.5;
  }

  .months .label.muted {
    min-height: 1.5em;
    font-variant-numeric: tabular-nums;
  }

  svg {
    display: block;
    overflow: visible;
  }

  /* Squares: faint when empty, then darker with more time that day. */
  rect {
    fill: var(--foreground-color);
  }

  .l0 {
    fill-opacity: 0.07;
  }

  .l1 {
    fill-opacity: 0.25;
  }

  .l2 {
    fill-opacity: 0.45;
  }

  .l3 {
    fill-opacity: 0.7;
  }

  .l4 {
    fill-opacity: 0.95;
  }

  rect.future {
    fill-opacity: 0.03;
  }

  /* Years on the left, legend on the right, right under the squares. */
  .calendar-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-3);
  }

  .years {
    display: flex;
    gap: var(--space-3);
    font-size: 13px;
  }

  .years a {
    text-decoration: none;
    opacity: 0.5;
    transition: opacity 150ms;
  }

  .years a:hover,
  .years a:focus-visible,
  .years a[aria-current="page"] {
    opacity: 1;
  }

  .years a[aria-current="page"] {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 5px;
    text-decoration-color: color-mix(in srgb, var(--foreground-color) 35%, transparent);
  }

  .legend {
    display: flex;
    align-items: center;
    gap: 3px;
    margin-left: auto;
  }

  .legend svg:first-of-type {
    margin-left: var(--space-1);
  }

  .legend svg:last-of-type {
    margin-right: var(--space-1);
  }

  /* Tables: the same columns style everywhere, hairlines between rows. */
  table {
    width: 100%;
    border-collapse: collapse;
  }

  th,
  td {
    padding: var(--space-2) 0;
    text-align: left;
    font-weight: inherit;
    white-space: nowrap;
    border-bottom: 1px solid color-mix(in srgb, var(--foreground-color) 10%, transparent);
  }

  th + th,
  th + td,
  td + td,
  td + th {
    padding-left: var(--space-3);
  }

  thead th {
    padding-top: 0;
    border-bottom-color: color-mix(in srgb, var(--foreground-color) 25%, transparent);
  }

  .sport {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  @media (max-width: 480px) {
    .stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .months {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    table {
      font-size: 13px;
    }

    .optional {
      display: none;
    }
  }
</style>
