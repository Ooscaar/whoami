---
// Rendered on each request from D1, which the Strava webhook + daily cron keep up to date
// (src/lib/strava/sync.ts). Visitors never trigger a Strava API call.
import { env } from "cloudflare:workers";
import Layout from "../layouts/Layout.astro";
import { recentActivities, yearTotals, type Activity, type YearTotals } from "../lib/strava/store.ts";
import { formatDate, formatDistance, formatDuration, formatPace, routePath, sportLabel } from "../lib/strava/format.ts";

export const prerender = false;

const year = new Date().getUTCFullYear();
let activities: Activity[] = [];
let totals: YearTotals[] = [];
try {
  [activities, totals] = await Promise.all([recentActivities(env.DB, 30), yearTotals(env.DB, year)]);
} catch (error) {
  // No DB binding (plain `astro dev`) or no tables yet (before the first sync).
  console.warn("activities: couldn't read D1:", error);
}

Astro.response.headers.set("Cache-Control", "public, max-age=300");

const ROUTE_SIZE = 40;
---

<Layout title="Activities — Òscar Pérez" description="What Òscar Pérez has been running and riding lately">
  <header>
    <h1>activities</h1>
    <p class="muted">what I've been running and riding lately, synced from strava.</p>
  </header>

  {
    totals.length > 0 && (
      <section class="totals" aria-label={`${year} so far`}>
        <h2 class="muted">{year} so far</h2>
        <ul>
          {totals.map((t) => (
            <li>
              <span>{sportLabel(t.sport_type)}</span>
              <span class="muted">
                {t.count}× · {formatDistance(t.distance)} · {formatDuration(t.moving_time)}
                {t.elevation >= 1 && ` · ${Math.round(t.elevation)} m up`}
              </span>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    activities.length === 0 ? (
      <p class="muted">no activities yet.</p>
    ) : (
      <ul class="list">
        {activities.map((a) => {
          const route = a.summary_polyline ? routePath(a.summary_polyline, ROUTE_SIZE) : null;
          const pace = formatPace(a.sport_type, a.average_speed);
          return (
            <li>
              <svg class="route" viewBox={`0 0 ${ROUTE_SIZE} ${ROUTE_SIZE}`} aria-hidden="true">
                {route ? <path d={route} /> : <circle cx={ROUTE_SIZE / 2} cy={ROUTE_SIZE / 2} r="1.5" />}
              </svg>
              <div class="text">
                <div class="what">
                  <span class="name">{a.name}</span>
                  <span class="meta muted">
                    {formatDate(a.start_date_local)} · {sportLabel(a.sport_type)} ·{" "}
                    <a href={`https://www.strava.com/activities/${a.id}`} target="_blank" rel="noopener noreferrer">
                      View on Strava
                    </a>
                  </span>
                </div>
                <div class="stats">
                  <span>{a.distance > 0 ? formatDistance(a.distance) : formatDuration(a.moving_time)}</span>
                  <span class="muted">
                    {a.distance > 0 ? formatDuration(a.moving_time) : ""}
                    {a.distance > 0 && pace && ` · ${pace}`}
                  </span>
                </div>
              </div>
            </li>
          );
        })}
      </ul>
    )
  }

  <p class="credits muted">Powered by Strava</p>
</Layout>

<style>
  header,
  .totals {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .totals h2 {
    font-size: 12px;
  }

  .totals li {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }

  .totals li .muted {
    text-align: right;
  }

  .meta a {
    white-space: nowrap;
  }

  .list li {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.75rem 0;
    border-top: 1px solid color-mix(in srgb, var(--foreground-color) 10%, transparent);
  }

  .list li:last-child {
    border-bottom: 1px solid color-mix(in srgb, var(--foreground-color) 10%, transparent);
  }

  /* The route as a thin line drawing, faded like the photos until hovered. */
  .route {
    flex: none;
    width: 40px;
    height: 40px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.25;
    stroke-linejoin: round;
    stroke-linecap: round;
    opacity: 0.45;
    transition: opacity 300ms ease;
  }

  .route circle {
    fill: currentColor;
    stroke: none;
  }

  .list li:hover .route {
    opacity: 1;
  }

  .text {
    flex: 1;
    min-width: 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }

  .what,
  .stats {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .name {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .stats {
    flex: none;
    align-items: flex-end;
    text-align: right;
    font-variant-numeric: tabular-nums;
  }

  .meta,
  .stats .muted {
    font-size: 12px;
    line-height: 1.5;
  }

  .credits {
    font-size: 11px;
    line-height: 1.6;
  }

  @media (max-width: 480px) {
    .text {
      flex-direction: column;
      align-items: flex-start;
      gap: 0;
    }

    .stats {
      flex-direction: row;
      gap: 0.5rem;
      align-items: baseline;
    }

    .stats .muted,
    .totals li .muted {
      font-size: 12px;
    }
  }
</style>
