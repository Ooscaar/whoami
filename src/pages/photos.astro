---
import Layout from "../layouts/Layout.astro";
import Gallery from "../components/Gallery.astro";
---

<Layout title="Photos — Òscar Pérez" description="Photos by Òscar Pérez">
  <header>
    <h1>photos</h1>
    <p class="muted">open a photo to see its story.</p>
  </header>

  <div class="bleed">
    <Gallery />
  </div>
</Layout>

<style>
  /* Let the gallery spread wider than the text column, still centered. */
  .bleed {
    width: min(64rem, 100vw - 3rem);
    margin-left: 50%;
    translate: -50% 0;
  }
</style>
