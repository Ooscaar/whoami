---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import { artists } from "../data/music";
---

<Layout title="Music — Òscar Pérez" description="Music Òscar Pérez loves">
  <header>
    <h1>music</h1>
    <p class="muted">artists I love, and my favorite song by each. press play to listen.</p>
  </header>

  <ul>
    {
      artists.map((artist) => (
        <li data-preview={artist.song.preview}>
          {/* The photo is a big, mouse-friendly play target; the song button below is the accessible one. */}
          <button type="button" class="play" tabindex="-1" aria-hidden="true">
            <Image src={artist.image} alt="" width={48} height={48} densities={[1, 2, 3]} />
            <svg class="icon" viewBox="0 0 16 16" aria-hidden="true">
              <path class="icon-play" d="M5 3.5v9l7.5-4.5z" />
              <path class="icon-pause" d="M4.5 3.5h2.5v9H4.5zM9 3.5h2.5v9H9z" />
            </svg>
          </button>
          <div class="text">
            <div class="who">
              <span>{artist.name}</span>
              <span class="song muted">
                <button
                  type="button"
                  class="toggle"
                  aria-pressed="false"
                  aria-label={`Play ${artist.song.title} by ${artist.name}`}
                >
                  <svg viewBox="0 0 16 16" aria-hidden="true">
                    <path class="icon-play" d="M5 3.5v9l7.5-4.5z" />
                    <path class="icon-pause" d="M4.5 3.5h2.5v9H4.5zM9 3.5h2.5v9H9z" />
                  </svg>
                  {artist.song.title}
                </button>
                <span class="time" aria-hidden="true" />
              </span>
            </div>
            <span class="muted">{artist.note}</span>
          </div>
          <span class="progress" aria-hidden="true" />
        </li>
      ))
    }
  </ul>

  <p class="credits muted">
    photos from wikimedia commons:{" "}
    {
      artists.map((artist, i) => (
        <span>
          {i > 0 && ", "}
          <a href={artist.credit.href} target="_blank" rel="noopener noreferrer">
            {artist.credit.author}
          </a>{" "}
          ({artist.credit.license})
        </span>
      ))
    }
  </p>
</Layout>

<script>
  // One shared player: playing a song stops whichever one was playing before.
  const audio = new Audio();
  audio.preload = "none";
  let current: HTMLLIElement | null = null;

  const stop = () => {
    audio.pause();
    current?.classList.remove("playing");
    current?.querySelector(".toggle")?.setAttribute("aria-pressed", "false");
    current?.style.setProperty("--progress", "0");
    const time = current?.querySelector(".time");
    if (time) time.textContent = "";
    current = null;
  };

  // Apple serves the previews as "audio/x-m4p", which some browsers (Firefox) refuse to play.
  // Fetch the file and relabel it as plain AAC/MP4, which every browser accepts.
  const sources = new Map<string, Promise<string>>();
  const load = (url: string) => {
    if (!sources.has(url)) {
      sources.set(
        url,
        fetch(url)
          .then((response) => {
            if (!response.ok) throw new Error(`HTTP ${response.status}`);
            return response.arrayBuffer();
          })
          .then((data) => URL.createObjectURL(new Blob([data], { type: "audio/mp4" })))
          .catch((error) => {
            sources.delete(url);
            throw error;
          }),
      );
    }
    return sources.get(url)!;
  };

  const format = (seconds: number) => `0:${String(Math.floor(seconds)).padStart(2, "0")}`;

  audio.addEventListener("timeupdate", () => {
    if (current && audio.duration) {
      current.style.setProperty("--progress", String(audio.currentTime / audio.duration));
      current.querySelector(".time")!.textContent = format(audio.duration - audio.currentTime);
    }
  });
  audio.addEventListener("ended", stop);

  document.addEventListener("astro:page-load", () => {
    document.querySelectorAll<HTMLButtonElement>("li[data-preview] :is(.play, .toggle)").forEach((button) => {
      button.addEventListener("click", () => {
        const item = button.closest("li")!;
        if (item === current) return stop();
        stop();
        current = item;
        item.classList.add("playing");
        item.querySelector(".toggle")!.setAttribute("aria-pressed", "true");
        load(item.dataset.preview!)
          .then((src) => {
            if (current !== item) return;
            audio.src = src;
            return audio.play();
          })
          .catch((error) => {
            console.error("Couldn't play the preview:", error);
            if (current === item) stop();
          });
      });
    });
  });

  // Leaving the page (client-side navigation) stops the music.
  document.addEventListener("astro:before-swap", stop);
</script>

<style>
  header {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    position: relative;
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.75rem 0;
    border-top: 1px solid color-mix(in srgb, var(--foreground-color) 10%, transparent);
  }

  li:last-child {
    border-bottom: 1px solid color-mix(in srgb, var(--foreground-color) 10%, transparent);
  }

  .play {
    position: relative;
    flex: none;
    width: 48px;
    height: 48px;
    padding: 0;
    border: 0;
    border-radius: 2px;
    overflow: hidden;
    background: none;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  /* Same treatment as the home portrait: black and white until hovered, tapped or playing. */
  .play img {
    width: 100%;
    height: 100%;
    filter: grayscale(1);
    opacity: 0.8;
    transition:
      filter 500ms ease,
      opacity 500ms ease;
  }

  li:hover .play img,
  .playing .play img {
    filter: none;
    opacity: 1;
  }

  .icon {
    position: absolute;
    inset: 0;
    margin: auto;
    width: 18px;
    height: 18px;
    fill: #fff;
    filter: drop-shadow(0 0 4px rgb(0 0 0 / 0.5));
    opacity: 0;
    transition: opacity 200ms ease;
  }

  .play:hover .icon,
  .playing .icon {
    opacity: 1;
  }

  .icon-pause,
  .playing .icon-play {
    display: none;
  }

  .playing .icon-pause {
    display: inline;
  }

  .text {
    flex: 1;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }

  .who {
    display: flex;
    flex-direction: column;
  }

  .song {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    font-size: 12px;
    line-height: 1.5;
  }

  .toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
    transition: color 150ms;
  }

  .toggle:hover,
  .toggle:focus-visible,
  .playing .toggle {
    color: var(--foreground-color);
  }

  .toggle:focus-visible {
    outline: 1px solid var(--foreground-color);
    outline-offset: 2px;
  }

  .toggle svg {
    flex: none;
    width: 10px;
    height: 10px;
    fill: currentColor;
  }

  .time {
    font-variant-numeric: tabular-nums;
  }


  /* A hairline along the bottom of the row that fills as the preview plays. */
  .progress {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 1px;
    background: var(--foreground-color);
    transform: scaleX(var(--progress, 0));
    transform-origin: left;
    transition: transform 250ms linear;
  }

  .credits {
    font-size: 11px;
    line-height: 1.6;
  }

  @media (max-width: 480px) {
    .text {
      flex-direction: column;
      align-items: flex-start;
      gap: 0;
    }

    .text > .muted {
      font-size: 12px;
      line-height: 1.5;
    }
  }
</style>
