# Strava credentials for scripts/strava.ts (`npm run strava`). Copy to .env (gitignored):
#   cp .env.example .env
# `npm run strava -- secrets` pushes them to the Worker; `npm run preview` reads them locally.

# From https://www.strava.com/settings/api
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Filled in by `npm run strava -- exchange <url>` (after `auth-url`).
STRAVA_REFRESH_TOKEN=
STRAVA_ATHLETE_ID=

# Filled in by `npm run strava -- verify-token`: checks the webhook subscription and
# authorizes manual syncs (POST /api/strava/sync).
STRAVA_VERIFY_TOKEN=

# Where `sync` and `webhook subscribe` point (defaults to the live site).
STRAVA_SITE_URL=https://oscarperezcastillo.com

# Access-token cache written by the CLI (don't edit).
STRAVA_ACCESS_TOKEN=
STRAVA_ACCESS_TOKEN_EXPIRES_AT=
